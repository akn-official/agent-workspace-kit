  "mcp": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {},
      "headers": {}
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${MCP_21ST_X_API_KEY}"
      },
      "env": {}
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "env": {},
      "headers": {}
    },
    "laya": {
      "type": "stdio",
      "command": "%HOME%/.laya/venv/Scripts/python.exe",
      "args": [
        "%HOME%/.laya/laya_mcp.py"
      ],
      "env": {},
      "headers": {}
    },
    "rea": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "%HOME%\\AppData\\Roaming\\npm\\node_modules\\rea-agents\\scripts\\rea.mjs",
        "mcp"
      ],
      "env": {},
      "headers": {}
    }
  },
